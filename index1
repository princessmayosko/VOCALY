<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Vocaly Tuner Panel</title>

<style>
:root{
  --bg:#0f172a;
  --panel:#111827;
  --border:rgba(255,255,255,0.08);
  --text:#e5e7eb;

  --do:#ef4444;
  --re:#f97316;
  --mi:#facc15;
  --fa:#22c55e;
  --sol:#22d3ee;
  --la:#8b5cf6;
  --si:#ec4899;
}

body{
  margin:0;
  background:var(--bg);
  font-family:Arial;
  color:white;
}

/* HANDLE */
.handle{
  position:fixed;
  left:0;
  top:50%;
  transform:translateY(-50%);
  width:28px;
  height:120px;
  background:rgba(255,255,255,0.08);
  border-top-right-radius:12px;
  border-bottom-right-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
  writing-mode:vertical-rl;
  cursor:pointer;
  z-index:1000;
  font-size:12px;
}

/* PANEL */
.panel{
  position:fixed;
  left:-140px;
  top:0;
  width:140px;
  height:100%;
  background:var(--panel);
  border-right:1px solid var(--border);
  transition:0.25s ease;
  z-index:999;
  display:flex;
  flex-direction:column;
  align-items:center;
  padding-top:20px;
}

.panel.open{
  left:0;
}

/* SCALE */
.scale{
  position:relative;
  height:80%;
  width:100%;
  display:flex;
  flex-direction:column;
  justify-content:space-around;
  align-items:center;
}

/* NOTE */
.note{
  width:100%;
  text-align:center;
  font-weight:700;
  opacity:0.4;
  transition:0.15s;
}

.note.active{
  opacity:1;
  transform:scale(1.2);
  filter:drop-shadow(0 0 8px currentColor);
}

/* COLORS */
.do{ color:var(--do); }
.re{ color:var(--re); }
.mi{ color:var(--mi); }
.fa{ color:var(--fa); }
.sol{ color:var(--sol); }
.la{ color:var(--la); }
.si{ color:var(--si); }

/* MIC */
.mic{
  margin-top:auto;
  margin-bottom:20px;
  padding:8px 14px;
  border-radius:10px;
  background:rgba(255,255,255,0.08);
  font-size:13px;
}
</style>
</head>

<body>

<div class="handle" onclick="togglePanel()">TUNER</div>

<div class="panel" id="panel">

  <div class="scale" id="scale">
    <div class="note do">Do</div>
    <div class="note si">Si</div>
    <div class="note la">La</div>
    <div class="note sol">Sol</div>
    <div class="note fa">Fa</div>
    <div class="note mi">Mi</div>
    <div class="note re">Re</div>
    <div class="note do">Do</div>
  </div>

  <div class="mic">🎤 mic</div>

</div>

<script>

/* PANEL */
function togglePanel(){
  panel.classList.toggle("open");
}

/* NOTE CLASS (OCTAVE INDEPENDENT) */
function midiToNoteClass(midi){
  const names = ["do","do","re","re","mi","fa","fa","sol","sol","la","la","si"];
  return names[midi % 12];
}

/* DEMO: RANDOM NOTE (SONRA TUNER BAĞLANACAK) */
function simulateNote(){
  const midi = Math.floor(Math.random()*12);
  const note = midiToNoteClass(midi);
  highlight(note);
}

/* HIGHLIGHT */
function highlight(noteName){
  document.querySelectorAll(".note").forEach(n=>n.classList.remove("active"));

  const el = document.querySelector("." + noteName);
  if(el) el.classList.add("active");
}

/* DEMO LOOP */
setInterval(simulateNote, 1000);

</script>

</body>
</html>
